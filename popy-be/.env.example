DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for Django admin over HTTPS in production (scheme + host)
# CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com,https://your-app.vercel.app

# MySQL (production / optional dev)
DB_NAME=pos_db
DB_USER=pos_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Set USE_SQLITE=True for local dev without MySQL
USE_SQLITE=True
# Optional override for SQLite file path (Docker uses /app/data/db.sqlite3)
# SQLITE_PATH=

# Brevo (transactional email) — https://www.brevo.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Popy POS

# Text.lk (SMS) — https://text.lk
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=
