DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (production / optional dev)
DB_NAME=pos_db
DB_USER=pos_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Set USE_SQLITE=True for local dev without MySQL
USE_SQLITE=True

# Brevo (transactional email) — https://www.brevo.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Popy POS

# Text.lk (SMS) — https://text.lk
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=
