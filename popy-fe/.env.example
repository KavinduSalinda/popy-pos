# API base URL (proxied to Django backend in dev). Defaults to /api.
# Dev proxy target: http://localhost:8000 (see vite.config.ts)
VITE_API_BASE_URL=/api

# Currency ISO code used for formatting (e.g. USD, EUR, INR).
VITE_CURRENCY=USD

# BCP-47 locale used for number/date/currency formatting.
VITE_LOCALE=en-US

# Default tax rate applied at checkout (0.1 = 10%).
VITE_TAX_RATE=0.1
