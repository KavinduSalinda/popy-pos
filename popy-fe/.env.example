# API base URL. Defaults to /api (Vite proxies this to Django in local dev).
# Production: set the full backend URL, including /api, at build time.
# VITE_API_BASE_URL=https://yourusername.pythonanywhere.com/api
VITE_API_BASE_URL=/api

# Currency ISO code used for formatting (e.g. USD, EUR, INR).
VITE_CURRENCY=USD

# BCP-47 locale used for number/date/currency formatting.
VITE_LOCALE=en-US

# Default tax rate applied at checkout (0.1 = 10%).
VITE_TAX_RATE=0.1
